{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "dynamiczne.info",
	"Version": "0.1.0.0",
	"Author": "Paweł Cierzniakowski",
	"Actions": [
		{
			"Name": "Cena teraz",
			"UUID": "info.dynamiczne.prices.now",
			"Icon": "imgs/actions/price/icon",
			"Tooltip": "Cena prądu brutto w bieżącej godzinie",
			"PropertyInspectorPath": "ui/price.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/price/key"
				}
			]
		},
		{
			"Name": "Cena za godzinę",
			"UUID": "info.dynamiczne.prices.next-hour",
			"Icon": "imgs/actions/price/icon",
			"Tooltip": "Cena prądu brutto w następnej godzinie",
			"PropertyInspectorPath": "ui/price.html",
			"Controllers": [
				"Keypad"
			],
			"UserTitleEnabled": false,
			"States": [
				{
					"Image": "imgs/actions/price/key"
				}
			]
		}
	],
	"Category": "dynamiczne.info",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Godzinowa cena prądu brutto z dynamiczne.info: teraz i za godzinę, w kolorze porady.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"URL": "https://dynamiczne.info",
	"UUID": "info.dynamiczne.prices"
}